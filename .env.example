# Bu dosyayı ".env" adıyla kopyalayıp kendi bilgilerinizle doldurun.

# Uygulamanın görünen adı
APP_NAME=Sezkar Muhasebe

# Sitenin dışarıdan açıldığı adres (e-postalardaki bağlantılar için)
BASE_URL=https://defter.ornek.com

# docker-compose ile kurulumda kullanılan alan adı (HTTPS sertifikası buna alınır)
DOMAIN=defter.ornek.com

# Site HTTPS üzerinden yayınlanıyorsa 1 yapın: oturum çerezi yalnızca HTTPS'te gönderilir
HTTPS_ONLY=1

# Saat dilimi
TZ_NAME=Europe/Istanbul

# --- E-posta hatırlatmaları (boş bırakılırsa uyarılar yalnızca sayfada görünür) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Gönderen adres, örn: Ortak Defter <defter@ornek.com>
SMTP_FROM=
# starttls (587) | ssl (465) | none
SMTP_TLS=starttls
# Hatırlatmaların gönderileceği en erken saat (0-23)
REMINDER_HOUR=9
REMINDERS_ENABLED=1

# Tek dosya için yükleme sınırı (MB)
MAX_UPLOAD_MB=15

# İsteğe bağlı ama internete açık kurulumda önerilir: verilirse ilk kurulum sayfası bu anahtarı sorar,
# böylece adresi sizden önce bulan biri defteri kendi adına kuramaz.
# KURULUM_ANAHTARI=

# İsteğe bağlı. Boş bırakılırsa ilk açılışta üretilip veri klasöründe saklanır.
# SECRET_KEY=
